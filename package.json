{
  "name": "@bridevmx/echodb",
  "version": "2.1.0",
  "description": "RAM-first document database backed by Mataroa and Echo Entries with PocketBase parity. Zero-dependency, append-only, atomic transactions, auto-compaction.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.js",
      "default": "./index.js",
      "types": "./index.d.ts"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "README.md",
    "LICENSE",
    "SKILL.md",
    "skills/"
  ],
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "test": "node test/test_export_import.js && node test/test_pocketbase_parity.js && node test/test_mataroa.js"
  },
  "keywords": [
    "echodb",
    "mataroa",
    "echo-entries",
    "supabase",
    "nosql",
    "document-database",
    "json-database",
    "ram-first",
    "append-only",
    "wal",
    "cms",
    "headless-cms",
    "zero-dependency"
  ],
  "author": "EchoDB Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bridevmx/echodb.git"
  },
  "bugs": { "url": "https://github.com/bridevmx/echodb/issues" },
  "homepage": "https://github.com/bridevmx/echodb#readme",
  "dependencies": {}
}
